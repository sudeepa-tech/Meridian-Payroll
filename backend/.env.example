PORT=4000
CORS_ORIGIN=http://localhost:5173
DB_FILE=./data/meridian.sqlite
# Secret used to sign auth tokens. If unset, a random secret is generated at boot (invalidates
# sessions on every restart) — set a real value for anything beyond local exploration.
JWT_SECRET=
# Optional: enables Claude-powered assistant. Without it the assistant runs in local analytical mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
